#include <stdio.h>

int main() {
    int disk[50] = {0};
    int start, length, i, flag = 0;

    printf("Enter starting block: ");
    scanf("%d", &start);

    printf("Enter file length: ");
    scanf("%d", &length);

    if(start < 0 || length <= 0 || start+length > 50) {
        printf("Invalid allocation\n");
        return 1;
    }

    for(i = start; i < start+length; i++) {
        if(disk[i] == 1) {
            flag = 1;
            break;
        }
    }

    if(flag == 0) {
        printf("Allocated blocks: ");

        for(i = start; i < start+length; i++) {
            disk[i] = 1;
            printf("%d ", i);
        }

        printf("\nFile allocated successfully\n");
    } else {
        printf("Blocks are not available\n");
    }

    return 0;
}
