#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <stdlib.h>

int main() {
    int source, destination;
    char buffer[1024];
    ssize_t bytes;

    /* Create source.txt and write sample content */
    source = open("source.txt", O_WRONLY | O_CREAT | O_TRUNC, 0644);
    if (source == -1) {
        perror("Cannot create source.txt");
        return 1;
    }

    char message[] = "Hello Operating Systems\n";
    if (write(source, message, sizeof(message) - 1) == -1) {
        perror("Write failed");
        close(source);
        return 1;
    }
    close(source);

    /* Open source file for reading */
    source = open("source.txt", O_RDONLY);
    if (source == -1) {
        perror("Cannot open source.txt");
        return 1;
    }

    /* Create destination file */
    destination = open("destination.txt",
                       O_WRONLY | O_CREAT | O_TRUNC, 0644);
    if (destination == -1) {
        perror("Cannot create destination.txt");
        close(source);
        return 1;
    }

    /* Copy file contents */
    while ((bytes = read(source, buffer, sizeof(buffer))) > 0) {
        ssize_t total = 0;
        while (total < bytes) {
            ssize_t written = write(destination, buffer + total,
                                    bytes - total);
            if (written <= 0) {
                perror("Write failed");
                close(source);
                close(destination);
                return 1;
            }
            total += written;
        }
    }

    if (bytes < 0) {
        perror("Read failed");
        close(source);
        close(destination);
        return 1;
    }

    close(source);
    close(destination);

    printf("File copied successfully.\n");
    printf("Source file: source.txt\n");
    printf("Destination file: destination.txt\n");

    return 0;
}
