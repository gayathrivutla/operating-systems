#include <stdio.h>

int main() {
    int disk[50] = {0};
    int index, n, b[50], i;

    printf("Enter index block: ");
    scanf("%d", &index);

    if(index < 0 || index >= 50)
        return 1;

    disk[index] = 1;

    printf("Enter number of blocks: ");
    scanf("%d", &n);

    if(n < 1 || n > 49)
        return 1;

    printf("Enter block numbers: ");

    for(i = 0; i < n; i++) {
        scanf("%d", &b[i]);

        if(b[i] < 0 || b[i] >= 50 || disk[b[i]]) {
            printf("Invalid or occupied block\n");
            return 1;
        }

        disk[b[i]] = 1;
    }

    printf("Index Block\tData Block\n");

    for(i = 0; i < n; i++)
        printf("%d\t\t%d\n", index, b[i]);

    printf("File allocated successfully\n");

    return 0;
}
