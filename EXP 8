
#include <stdio.h>

int main(void)
{
    int n, q, i, time = 0, remaining;
    int bt[20], rem[20], wt[20], tat[20];

    printf("Enter number of processes: ");
    scanf("%d", &n);
    if (n < 1 || n > 20) return 1;

    for (i = 0; i < n; i++) {
        printf("Burst time of P%d: ", i + 1);
        scanf("%d", &bt[i]);
        if (bt[i] <= 0) return 1;
        rem[i] = bt[i];
    }

    printf("Enter time quantum: ");
    scanf("%d", &q);
    if (q <= 0) return 1;

    remaining = n;

    while (remaining > 0) {
        for (i = 0; i < n; i++) {
            if (rem[i] > 0) {
                int slice = rem[i] < q ? rem[i] : q;
                time += slice;
                rem[i] -= slice;

                if (rem[i] == 0) {
                    tat[i] = time;
                    wt[i] = tat[i] - bt[i];
                    remaining--;
                }
            }
        }
    }

    printf("\nProcess\tBT\tWT\tTAT\n");
    for (i = 0; i < n; i++)
        printf("P%d\t%d\t%d\t%d\n",
               i + 1, bt[i], wt[i], tat[i]);

    return 0;
}
