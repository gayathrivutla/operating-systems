
#include <stdio.h>

int main(void)
{
    int n, i, time = 0, done = 0, idx;
    int at[20], bt[20], ct[20], wt[20], tat[20];
    int used[20] = {0};
    float awt = 0, atat = 0;

    printf("Enter number of processes: ");
    scanf("%d", &n);
    if (n < 1 || n > 20) return 1;

    for (i = 0; i < n; i++) {
        printf("Arrival and burst time of P%d: ", i + 1);
        scanf("%d%d", &at[i], &bt[i]);
        if (at[i] < 0 || bt[i] <= 0) return 1;
    }

    while (done < n) {
        idx = -1;

        for (i = 0; i < n; i++) {
            if (!used[i] && at[i] <= time) {
                if (idx == -1 || bt[i] < bt[idx])
                    idx = i;
            }
        }

        if (idx == -1) {
            time++;
            continue;
        }

        time += bt[idx];
        ct[idx] = time;
        tat[idx] = ct[idx] - at[idx];
        wt[idx] = tat[idx] - bt[idx];
        used[idx] = 1;
        done++;
    }

    printf("\nProcess\tAT\tBT\tWT\tTAT\n");
    for (i = 0; i < n; i++) {
        awt += wt[i];
        atat += tat[i];
        printf("P%d\t%d\t%d\t%d\t%d\n",
               i + 1, at[i], bt[i], wt[i], tat[i]);
    }

    printf("Average WT = %.2f\n", awt / n);
    printf("Average TAT = %.2f\n", atat / n);
    return 0;
}
