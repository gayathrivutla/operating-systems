#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>

sem_t forklock[5], room;

void *philosopher(void *arg) {
    int id = *(int *)arg;

    printf("Philosopher %d is thinking\n", id);

    sem_wait(&room);
    sem_wait(&forklock[id]);
    sem_wait(&forklock[(id+1)%5]);

    printf("Philosopher %d is eating\n", id);

    sem_post(&forklock[(id+1)%5]);
    sem_post(&forklock[id]);
    sem_post(&room);

    printf("Philosopher %d finished eating\n", id);

    return NULL;
}

int main() {
    pthread_t p[5];
    int id[5], i;

    sem_init(&room, 0, 4);

    for(i = 0; i < 5; i++)
        sem_init(&forklock[i], 0, 1);

    for(i = 0; i < 5; i++) {
        id[i] = i;
        pthread_create(&p[i], NULL, philosopher, &id[i]);
    }

    for(i = 0; i < 5; i++)
        pthread_join(p[i], NULL);

    for(i = 0; i < 5; i++)
        sem_destroy(&forklock[i]);

    sem_destroy(&room);

    return 0;
}
