#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main() {
    int fd, n;
    char buffer[100];

    fd = open("sample.txt", O_CREAT | O_RDWR | O_TRUNC, 0644);

    if(fd < 0) {
        perror("open");
        return 1;
    }

    write(fd, "Hello UNIX", 10);
    printf("File created and written successfully\n");

    lseek(fd, 0, SEEK_SET);

    n = read(fd, buffer, 99);
    buffer[n] = '\0';

    printf("File contents: %s\n", buffer);

    close(fd);
    printf("File closed successfully\n");

    return 0;
}
