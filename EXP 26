#include <stdio.h>

int main() {
    FILE *fp;
    char ch;

    fp = fopen("file.txt", "w");

    if(fp == NULL)
        return 1;

    fprintf(fp, "Welcome to OS Lab");
    fclose(fp);

    printf("File created successfully\n");

    fp = fopen("file.txt", "a");
    fprintf(fp, "\nFile management operations");
    fclose(fp);

    printf("File appended successfully\n");

    fp = fopen("file.txt", "r");

    printf("File contents:\n");

    int c;
    while((c = fgetc(fp)) != EOF)
        putchar(c);

    fclose(fp);

    rename("file.txt", "newfile.txt");
    printf("\nFile renamed successfully\n");

    remove("newfile.txt");
    printf("File deleted successfully\n");

    return 0;
}
