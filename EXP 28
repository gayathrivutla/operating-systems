#include <stdio.h>
#include <string.h>

int main() {
    FILE *fp;
    char filename[50], word[50], line[256];
    int found = 0;

    printf("Enter file name: ");
    scanf("%49s", filename);

    printf("Enter search word: ");
    scanf("%49s", word);

    fp = fopen(filename, "r");

    if(fp == NULL) {
        printf("File not found\n");
        return 1;
    }

    while(fgets(line, sizeof(line), fp)) {
        if(strstr(line, word) != NULL) {
            printf("%s", line);
            found = 1;
        }
    }

    if(!found)
        printf("No matching lines found\n");

    fclose(fp);

    return 0;
}
