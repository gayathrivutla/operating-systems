#include <stdio.h>

int main() {
    int p[] = {7,0,1,2,0,3,0,4,2,3};
    int f[3] = {-1,-1,-1};
    int i, j, k, pos, far, hit, fault = 0;

    printf("Page\tFrames\n");

    for(i = 0; i < 10; i++) {
        hit = 0;

        for(j = 0; j < 3; j++)
            if(f[j] == p[i])
                hit = 1;

        if(!hit) {
            pos = -1;

            for(j = 0; j < 3; j++) {
                if(f[j] == -1) {
                    pos = j;
                    break;
                }
            }

            if(pos == -1) {
                far = -1;

                for(j = 0; j < 3; j++) {
                    for(k = i+1; k < 10; k++)
                        if(f[j] == p[k])
                            break;

                    if(k > far) {
                        far = k;
                        pos = j;
                    }
                }
            }

            f[pos] = p[i];
            fault++;
        }

        printf("%d\t", p[i]);

        for(j = 0; j < 3; j++)
            printf("%d ", f[j]);

        printf("\n");
    }

    printf("Total page faults: %d\n", fault);

    return 0;
}
