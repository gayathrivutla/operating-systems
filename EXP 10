
#include <stdio.h>
#include <string.h>
#include <sys/ipc.h>
#include <sys/msg.h>

struct message {
    long type;
    char text[100];
};

int main(void)
{
    int qid;
    struct message msg;

    qid = msgget(IPC_PRIVATE, IPC_CREAT | 0600);
    if (qid == -1) {
        perror("msgget");
        return 1;
    }

    msg.type = 1;
    strcpy(msg.text, "Hello through message queue!");

    if (msgsnd(qid, &msg, strlen(msg.text) + 1, 0) == -1) {
        perror("msgsnd");
        msgctl(qid, IPC_RMID, NULL);
        return 1;
    }

    if (msgrcv(qid, &msg, sizeof(msg.text), 1, 0) == -1) {
        perror("msgrcv");
        msgctl(qid, IPC_RMID, NULL);
        return 1;
    }

    printf("Received message: %s\n", msg.text);

    msgctl(qid, IPC_RMID, NULL);
    return 0;
}
