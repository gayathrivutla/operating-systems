#include <stdio.h>
#include <sys/stat.h>

int main() {
    FILE *fp;
    struct stat s;

    fp = fopen("permission.txt", "w");

    if(fp == NULL)
        return 1;

    fprintf(fp, "Linux File Permissions");
    fclose(fp);

    chmod("permission.txt", 0644);

    if(stat("permission.txt", &s) == -1)
        return 1;

    printf("File permissions: ");

    printf((s.st_mode & S_IRUSR) ? "r" : "-");
    printf((s.st_mode & S_IWUSR) ? "w" : "-");
    printf((s.st_mode & S_IXUSR) ? "x" : "-");

    printf((s.st_mode & S_IRGRP) ? "r" : "-");
    printf((s.st_mode & S_IWGRP) ? "w" : "-");
    printf((s.st_mode & S_IXGRP) ? "x" : "-");

    printf((s.st_mode & S_IROTH) ? "r" : "-");
    printf((s.st_mode & S_IWOTH) ? "w" : "-");
    printf((s.st_mode & S_IXOTH) ? "x" : "-");

    printf("\nOwner: Read and Write");
    printf("\nGroup: Read only");
    printf("\nOthers: Read only\n");

    printf("Octal permission: %03o\n",
           (unsigned int)(s.st_mode & 0777));

    return 0;
}
