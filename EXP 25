#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>

int main() {
    int fd, flags;
    struct stat s;
    DIR *d;
    struct dirent *entry;

    fd = open("test.txt", O_CREAT | O_RDWR | O_TRUNC, 0644);

    if(fd < 0)
        return 1;

    write(fd, "Operating System", 16);

    flags = fcntl(fd, F_GETFL);
    printf("Access mode: %d\n", flags & O_ACCMODE);

    printf("File position: %ld\n",
           (long)lseek(fd, 0, SEEK_END));

    stat("test.txt", &s);
    printf("File size: %ld bytes\n", (long)s.st_size);

    close(fd);

    d = opendir(".");

    if(d != NULL) {
        printf("Directory contents:\n");

        while((entry = readdir(d)) != NULL)
            printf("%s\n", entry->d_name);

        closedir(d);
    }

    return 0;
}
