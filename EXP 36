#include <stdio.h>

int main() {
    int disk[50] = {0};
    int next[50], b[50], n, i;

    printf("Enter number of blocks: ");
    scanf("%d", &n);

    if(n < 1 || n > 50)
        return 1;

    printf("Enter block numbers: ");

    for(i = 0; i < n; i++) {
        scanf("%d", &b[i]);

        if(b[i] < 0 || b[i] >= 50 || disk[b[i]]) {
            printf("Invalid or occupied block\n");
            return 1;
        }

        disk[b[i]] = 1;
    }

    for(i = 0; i < n-1; i++)
        next[b[i]] = b[i+1];

    next[b[n-1]] = -1;

    printf("Starting block: %d\n", b[0]);
    printf("Ending block: %d\n", b[n-1]);

    printf("Linked allocation: ");

    i = b[0];

    while(i != -1) {
        printf("%d -> ", i);
        i = next[i];
    }

    printf("NULL\n");

    return 0;
}
