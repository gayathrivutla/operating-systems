
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <sys/wait.h>

int main(void)
{
    int shmid;
    char *data;
    pid_t pid;

    shmid = shmget(IPC_PRIVATE, 1024, IPC_CREAT | 0600);
    if (shmid == -1) {
        perror("shmget");
        return 1;
    }

    data = shmat(shmid, NULL, 0);
    if (data == (char *)-1) {
        perror("shmat");
        shmctl(shmid, IPC_RMID, NULL);
        return 1;
    }

    strcpy(data, "Hello from shared memory!");

    pid = fork();

    if (pid < 0) {
        perror("fork");
        shmdt(data);
        shmctl(shmid, IPC_RMID, NULL);
        return 1;
    }

    if (pid == 0) {
        printf("Child reads: %s\n", data);
        fflush(stdout);
        shmdt(data);
        _exit(0);
    } else {
        wait(NULL);
        shmdt(data);
        shmctl(shmid, IPC_RMID, NULL);
        printf("Shared memory removed.\n");
    }

    return 0;
}
