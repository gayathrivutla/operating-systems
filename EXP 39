#include <stdio.h>
#include <stdlib.h>

int main() {
    int r[] = {98,183,37,122,14,124,65,67};
    int head = 53, total = 0, disk = 200;
    int i, j, temp, pos;

    for(i = 0; i < 8; i++) {
        for(j = i+1; j < 8; j++) {
            if(r[i] > r[j]) {
                temp = r[i];
                r[i] = r[j];
                r[j] = temp;
            }
        }
    }

    for(pos = 0; pos < 8 && r[pos] < head; pos++);

    printf("Seek sequence: %d", head);

    for(i = pos; i < 8; i++) {
        total += abs(head-r[i]);
        head = r[i];
        printf(" -> %d", head);
    }

    total += disk-1-head;
    printf(" -> %d", disk-1);

    total += disk-1;
    head = 0;
    printf(" -> 0");

    for(i = 0; i < pos; i++) {
        total += abs(head-r[i]);
        head = r[i];
        printf(" -> %d", head);
    }

    printf("\nTotal head movement: %d\n", total);

    return 0;
}
