#include <stdio.h>
#include <string.h>

int main() {
    char files[20][30], name[30];
    int n, i, found = 0;

    printf("Enter number of files: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++) {
        printf("Enter file name: ");
        scanf("%29s", files[i]);
    }

    printf("\nDirectory contents:\n");
    for(i = 0; i < n; i++)
        printf("%s\n", files[i]);

    printf("Enter file to search: ");
    scanf("%29s", name);

    for(i = 0; i < n; i++) {
        if(strcmp(files[i], name) == 0) {
            found = 1;
            break;
        }
    }

    if(found)
        printf("File found\n");
    else
        printf("File not found\n");

    return 0;
}
